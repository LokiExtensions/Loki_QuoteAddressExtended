<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_success">
        <observer name="Loki_QuoteAddressExtended::linkOrderAddressesToQuoteAddressExtended"
                  instance="Loki\QuoteAddressExtended\Observer\LinkOrderAddressesToQuoteAddressExtended"/>
        <observer name="Loki_QuoteAddressExtended::copyQuoteAddressExtendedToCustomerAddress"
                  instance="Loki\QuoteAddressExtended\Observer\CopyQuoteAddressExtendedToCustomerAddress"/>
    </event>
    <event name="sales_quote_merge_after">
        <observer name="Loki_QuoteAddressExtended::copyQuoteAddressExtendedOnQuoteMerge"
                  instance="Loki\QuoteAddressExtended\Observer\CopyQuoteAddressExtendedOnQuoteMerge"/>
    </event>
    <event name="sales_quote_address_save_after">
        <observer name="Loki_QuoteAddressExtended::copyCustomerAddressExtendedToQuoteAddress"
                  instance="Loki\QuoteAddressExtended\Observer\CopyCustomerAddressExtendedToQuoteAddress"/>
    </event>
    <event name="email_order_set_template_vars_before">
        <observer name="Loki_QuoteAddressExtended::addQuoteAddressExtendedToEmailVars"
                  instance="Loki\QuoteAddressExtended\Observer\AddQuoteAddressExtendedToEmailVars"/>
    </event>
    <event name="email_invoice_set_template_vars_before">
        <observer name="Loki_QuoteAddressExtended::addQuoteAddressExtendedToEmailVars"
                  instance="Loki\QuoteAddressExtended\Observer\AddQuoteAddressExtendedToEmailVars"/>
    </event>
    <event name="email_shipment_set_template_vars_before">
        <observer name="Loki_QuoteAddressExtended::addQuoteAddressExtendedToEmailVars"
                  instance="Loki\QuoteAddressExtended\Observer\AddQuoteAddressExtendedToEmailVars"/>
    </event>
    <event name="email_creditmemo_set_template_vars_before">
        <observer name="Loki_QuoteAddressExtended::addQuoteAddressExtendedToEmailVars"
                  instance="Loki\QuoteAddressExtended\Observer\AddQuoteAddressExtendedToEmailVars"/>
    </event>
</config>
